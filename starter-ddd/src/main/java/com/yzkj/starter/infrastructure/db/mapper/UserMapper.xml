<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yzkj.starter.infrastructure.db.mapper.UserMapper">
    <select id="queryUserByUserId" resultType="com.yzkj.starter.infrastructure.db.model.UserPO">
        SELECT * FROM user AS tu WHERE tu.user_id = #{userId,jdbcType=VARCHAR}
    </select>
</mapper>